---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Note from '../../components/Note.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const getPostTags = (entry: Props) => entry.data.tags.length ? entry.data.tags : [entry.id.split('/')[0]];
const tags = getPostTags(post);
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = allPosts.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;
const relatedPosts = allPosts
    .filter((entry) => entry.id !== post.id)
    .map((entry) => {
        const entryTags = getPostTags(entry);
        const sharedTagCount = entryTags.filter((tag) => tags.includes(tag)).length;

        return { entry, tags: entryTags, sharedTagCount };
    })
    .filter((item) => item.sharedTagCount > 0)
    .sort((a, b) => b.sharedTagCount - a.sharedTagCount || b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
    .slice(0, 3);
---

<Layout title={post.data.title} description={post.data.description} wide={true}>
    <!-- 阅读进度条 -->
    <div id="reading-progress" class="reading-progress" style="width: 0%"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative overflow-visible">
        <!-- TOC 侧边栏 -->
        <aside class="hidden lg:block lg:col-span-3 xl:col-span-2 order-1">
            <div class="sticky top-24">
                <div class="mb-3">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">目录</span>
                </div>
                <TableOfContents headings={headings} />
            </div>
        </aside>

        <!-- 文章正文 -->
        <article id="article-content" class="lg:col-span-9 xl:col-span-7 order-2 prose dark:prose-invert max-w-none prose-headings:font-bold prose-img:rounded-xl prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-700/50 relative overflow-visible">
            <!-- 文章元数据 -->
            <div class="mb-8 text-center not-prose">
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-extrabold tracking-tight mb-4 text-slate-900 dark:text-slate-100">
                    {post.data.title}
                </h1>
                <div class="flex items-center justify-center gap-4 text-sm">
                    <time datetime={post.data.pubDate.toISOString()} class="text-slate-500 dark:text-slate-400 font-mono">
                        {post.data.pubDate.toLocaleDateString('zh-CN', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                        })}
                    </time>
                    {post.data.updatedDate && (
                        <span class="text-slate-400 dark:text-slate-500 text-xs">
                            更新于 {post.data.updatedDate.toLocaleDateString('zh-CN', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                            })}
                        </span>
                    )}
                </div>
                <!-- 标签装饰 -->
                <div class="mt-4 flex flex-wrap justify-center gap-2">
                    {tags.map((tag) => (
                        <span class="tag text-xs">{tag}</span>
                    ))}
                </div>
            </div>

            <!-- Hero 图片 -->
            {post.data.heroImage && (
                <div class="not-prose mb-8 overflow-hidden rounded-xl shadow-lg group">
                    <Image src={post.data.heroImage} alt={post.data.title} width={1020} height={510} class="w-full h-auto rounded-xl transition-transform duration-700 group-hover:scale-[1.02]" />
                </div>
            )}

            <!-- 正文内容 -->
            <Content components={{ Note }} />

            <div class="not-prose mt-16 border-t border-slate-200 pt-8 dark:border-slate-800">
                <nav class="grid gap-4 md:grid-cols-2" aria-label="文章导航">
                    {newerPost ? (
                        <a href={`/blog/${newerPost.id}/`} class="group rounded-xl border border-slate-200/70 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-card-hover dark:border-slate-800/70 dark:bg-slate-900 dark:hover:border-primary-600">
                            <span class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">较新一篇</span>
                            <h2 class="mt-2 line-clamp-2 text-base font-bold leading-snug text-slate-950 transition group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
                                {newerPost.data.title}
                            </h2>
                            <div class="mt-3 flex flex-wrap gap-2">
                                {getPostTags(newerPost).slice(0, 2).map((tag) => (
                                    <span class="tag text-xs">{tag}</span>
                                ))}
                            </div>
                        </a>
                    ) : (
                        <div class="rounded-xl border border-dashed border-slate-200/80 p-5 text-sm text-slate-400 dark:border-slate-800 dark:text-slate-500">
                            已经是最新文章
                        </div>
                    )}

                    {olderPost ? (
                        <a href={`/blog/${olderPost.id}/`} class="group rounded-xl border border-slate-200/70 bg-white p-5 text-right shadow-sm transition hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-card-hover dark:border-slate-800/70 dark:bg-slate-900 dark:hover:border-primary-600">
                            <span class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">较早一篇</span>
                            <h2 class="mt-2 line-clamp-2 text-base font-bold leading-snug text-slate-950 transition group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
                                {olderPost.data.title}
                            </h2>
                            <div class="mt-3 flex flex-wrap justify-end gap-2">
                                {getPostTags(olderPost).slice(0, 2).map((tag) => (
                                    <span class="tag text-xs">{tag}</span>
                                ))}
                            </div>
                        </a>
                    ) : (
                        <div class="rounded-xl border border-dashed border-slate-200/80 p-5 text-right text-sm text-slate-400 dark:border-slate-800 dark:text-slate-500">
                            已经是最早文章
                        </div>
                    )}
                </nav>

                {relatedPosts.length > 0 && (
                    <section class="mt-10">
                        <div class="mb-4 flex items-end justify-between gap-4">
                            <div>
                                <p class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400">related</p>
                                <h2 class="mt-1 text-xl font-display font-bold text-slate-950 dark:text-white">同标签相关文章</h2>
                            </div>
                            <a href="/blog" class="link-underline text-sm font-semibold text-primary-600 dark:text-primary-400">全部文章</a>
                        </div>

                        <div class="grid gap-4">
                            {relatedPosts.map(({ entry, tags: entryTags }) => (
                                <a href={`/blog/${entry.id}/`} class="group rounded-xl border border-slate-200/70 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-card-hover dark:border-slate-800/70 dark:bg-slate-900 dark:hover:border-primary-600">
                                    <div class="flex flex-wrap items-center gap-2">
                                        {entryTags.slice(0, 3).map((tag) => (
                                            <span class="tag text-xs">{tag}</span>
                                        ))}
                                        <time class="font-mono text-xs text-slate-400 dark:text-slate-500">
                                            {entry.data.pubDate.toLocaleDateString('zh-CN', {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric',
                                            })}
                                        </time>
                                    </div>
                                    <h3 class="mt-3 text-base font-bold leading-snug text-slate-950 transition group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400">
                                        {entry.data.title}
                                    </h3>
                                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                                        {entry.data.description}
                                    </p>
                                </a>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        </article>
    </div>
</Layout>

<style is:global>
    .code-block-wrapper {
        position: relative;
        border-radius: 0.75rem;
        overflow: hidden;
    }
    .code-block-wrapper::before {
        content: attr(data-lang);
        position: absolute;
        top: 0;
        left: 0;
        padding: 0.2rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0 0 0.5rem 0;
        z-index: 1;
        pointer-events: none;
    }
    .copy-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.35rem;
        border-radius: 0.4rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(255, 255, 255, 0.45);
        cursor: pointer;
        opacity: 0;
        transition: all 0.2s ease;
        line-height: 1;
        z-index: 2;
    }
    .code-block-wrapper:hover .copy-btn {
        opacity: 1;
    }
    .copy-btn:hover {
        background: rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.9);
        border-color: rgba(255, 255, 255, 0.25);
    }
</style>

<script>
    // 阅读进度条
    const progressBar = document.getElementById('reading-progress');
    const article = document.getElementById('article-content');

    function updateProgress() {
        if (!article || !progressBar) return;

        const viewportHeight = window.innerHeight;
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const rect = article.getBoundingClientRect();
        const articleBottom = scrollTop + rect.top + rect.height;
        const maxPageScroll = Math.max(0, document.documentElement.scrollHeight - viewportHeight);
        const readingEnd = Math.min(maxPageScroll, Math.max(0, articleBottom - viewportHeight));
        const progress = readingEnd <= 0
            ? 100
            : Math.min(100, Math.max(0, (scrollTop / readingEnd) * 100));

        progressBar.style.width = `${progress}%`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    window.addEventListener('load', updateProgress);
    updateProgress();

    // 代码复制功能 + 语言标签
    const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

    document.querySelectorAll('article pre').forEach((pre) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';

        // 尝试识别语言
        const codeEl = pre.querySelector('code');
        const classList = codeEl?.className || '';
        const langMatch = classList.match(/language-(\w+)/);
        if (langMatch) {
            wrapper.setAttribute('data-lang', langMatch[1]);
        }

        pre.parentNode!.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.setAttribute('aria-label', '复制代码');
        btn.innerHTML = copyIcon;
        btn.addEventListener('click', async () => {
            const code = pre.querySelector('code');
            const text = (code || pre).textContent || '';
            await navigator.clipboard.writeText(text);
            btn.innerHTML = checkIcon;
            btn.style.color = '#4ade80';
            btn.style.borderColor = 'rgba(74, 222, 128, 0.3)';
            setTimeout(() => {
                btn.innerHTML = copyIcon;
                btn.style.color = '';
                btn.style.borderColor = '';
            }, 1500);
        });
        wrapper.appendChild(btn);
    });
</script>
