---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 宋体仅在随笔页加载（按 unicode-range 子集化，只下载用到的字形段）
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';

const essays = (await getCollection('essays')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="随笔 | Lizlog" description="非技术的字：随笔、乐评与生活。" tone="essay">
    <section class="mx-auto max-w-xl animate-fade-in">
        <!-- 题记 -->
        <header class="pt-10 pb-14 text-center md:pt-14">
            <h1 class="font-serif text-xl tracking-[0.5em] [margin-right:-0.5em] text-slate-700 dark:text-slate-300">
                人生朝露 · 艺术千秋
            </h1>
        </header>

        <ol class="border-t border-slate-200/70 dark:border-slate-800/70">
            {essays.map((essay) => (
                <li class="border-b border-slate-200/70 dark:border-slate-800/70">
                    <a href={`/essays/${essay.id}/`} class="group flex flex-col gap-1.5 py-6 sm:flex-row sm:items-baseline sm:gap-8">
                        <time
                            datetime={essay.data.pubDate.toISOString()}
                            class="shrink-0 font-serif text-xs text-slate-400 dark:text-slate-500 sm:w-28"
                        >
                            {essay.data.pubDate.toLocaleDateString('zh-CN', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                            })}
                        </time>
                        <span class="font-serif text-lg leading-relaxed text-slate-800 transition-colors duration-300 group-hover:text-slate-950 dark:text-slate-200 dark:group-hover:text-white">
                            {essay.data.title}
                        </span>
                    </a>
                </li>
            ))}
        </ol>

        {essays.length === 0 && (
            <p class="py-10 text-center font-serif text-sm text-slate-400 dark:text-slate-500">
                还没有随笔。
            </p>
        )}
    </section>
</Layout>
