---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 宋体仅在随笔页加载（按 unicode-range 子集化，只下载用到的字形段）
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';

export async function getStaticPaths() {
    const essays = await getCollection('essays');
    return essays.map((essay) => ({
        params: { slug: essay.id },
        props: essay,
    }));
}
type Props = CollectionEntry<'essays'>;

const essay = Astro.props;
const { Content } = await render(essay);
---

<Layout title={`${essay.data.title} | 随笔`} description={essay.data.description || essay.data.title} tone="essay">
    <article class="mx-auto max-w-[40rem] animate-fade-in">
        <header class="pt-8 pb-12 text-center md:pt-12">
            <h1 class="font-serif text-2xl font-semibold leading-snug tracking-wide text-slate-900 dark:text-slate-100 md:text-3xl">
                {essay.data.title}
            </h1>
            <time
                datetime={essay.data.pubDate.toISOString()}
                class="mt-5 inline-block font-serif text-xs text-slate-400 dark:text-slate-500"
            >
                {essay.data.pubDate.toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                })}
            </time>
            <div class="mx-auto mt-8 h-px w-10 bg-slate-300 dark:bg-slate-700"></div>
        </header>

        <div class="essay-prose">
            <Content />
        </div>

        <footer class="mt-16 flex flex-col items-center gap-8 pb-4">
            <div class="h-px w-10 bg-slate-300 dark:bg-slate-700"></div>
            <a
                href="/essays"
                class="font-mono text-xs tracking-[0.2em] text-slate-400 transition-colors duration-300 hover:text-slate-700 dark:text-slate-500 dark:hover:text-slate-300"
            >
                ← 随笔
            </a>
        </footer>
    </article>
</Layout>

<style is:global>
    /* 随笔正文：宋体、宽行距、灰阶 —— 与技术文章刻意不同的一间房 */
    .essay-prose {
        font-family: 'Noto Serif SC', 'Songti SC', 'STSong', 'Source Han Serif SC', 'SimSun', serif;
        font-size: 1.0625rem;
        line-height: 2.1;
        letter-spacing: 0.01em;
        color: #334155;
    }

    .dark .essay-prose {
        color: #cbd5e1;
    }

    .essay-prose p {
        margin: 1.55em 0;
    }

    .essay-prose h2,
    .essay-prose h3 {
        margin: 2.4em 0 1.1em;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: #1e293b;
    }

    .essay-prose h2 {
        font-size: 1.25em;
    }

    .essay-prose h3 {
        font-size: 1.1em;
    }

    .dark .essay-prose h2,
    .dark .essay-prose h3 {
        color: #e2e8f0;
    }

    /* 引文像耳语：一条发丝线，不要色块 */
    .essay-prose blockquote {
        margin: 2.2em 0;
        padding: 0.1em 0 0.1em 1.5em;
        border-left: 1px solid #cbd5e1;
        color: #64748b;
    }

    .dark .essay-prose blockquote {
        border-left-color: #475569;
        color: #94a3b8;
    }

    .essay-prose blockquote p {
        margin: 0.5em 0;
    }

    /* 链接保持墨色，只有一条细下划线 */
    .essay-prose a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: #94a3b8;
        text-decoration-thickness: 1px;
        text-underline-offset: 5px;
        transition: text-decoration-color 0.3s ease;
    }

    .essay-prose a:hover {
        text-decoration-color: currentColor;
    }

    /* 分隔线化为三点（asterism） */
    .essay-prose hr {
        margin: 2.8em 0;
        border: none;
        text-align: center;
    }

    .essay-prose hr::after {
        content: '·\2002·\2002·';
        letter-spacing: 0.6em;
        color: #94a3b8;
    }

    /* 强调不换色相，只换形与深浅：粗体加深一档墨色 */
    .essay-prose strong {
        font-weight: 600;
        color: #1e293b;
    }

    .dark .essay-prose strong {
        color: #f1f5f9;
    }

    /* 中文没有真斜体：按传统排版惯例，强调排楷体正体，不做机械倾斜 */
    .essay-prose em {
        font-style: normal;
        font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', 'BiauKai', 'Noto Serif SC', 'Songti SC', serif;
    }

    .essay-prose img {
        margin: 2.2em auto;
        border-radius: 0.25rem;
    }

    .essay-prose code {
        font-family: 'Sometype Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.85em;
        color: #475569;
    }

    .dark .essay-prose code {
        color: #94a3b8;
    }
</style>
